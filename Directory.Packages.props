<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Os pacotes PMQ são liberados juntos e testados como um conjunto, então a política é
    declarar a versão corrente de cada um em vez do mínimo teórico. Sem isso, quem
    instalasse só este pacote receberia a 1.0.7, em que Validatable ainda está no
    namespace antigo.
  -->
  <ItemGroup>
    <PackageVersion Include="PMQ.Notifications" Version="1.1.2" />
  </ItemGroup>

  <ItemGroup Label="Testes">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Moq.AutoMock" Version="4.0.3" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!--
      Cobertura pelo Microsoft.Testing.Platform. O coverlet.collector é data collector
      do VSTest e não roda neste caminho: no xunit.v3 o MTP não suporta mais a ponte
      VSTest no SDK 10.
    -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
  </ItemGroup>

  <!--
    TestHost acompanha o runtime, então segue a mesma regra dos pacotes de runtime:
    cada target pede a versão da sua própria linha LTS.
  -->
  <ItemGroup Label="Testes (net8.0)" Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="8.0.31" />
  </ItemGroup>

  <ItemGroup Label="Testes (net10.0)" Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
  </ItemGroup>

</Project>
