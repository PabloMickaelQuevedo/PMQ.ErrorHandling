<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>PMQ.ErrorHandling</PackageId>
    <Version>1.1.4</Version>
    <Product>PMQ.ErrorHandling</Product>
    <Description>
      A comprehensive error handling library for .NET applications, providing exception filters, notification mapping, model state validation, and centralized error response formatting for ASP.NET Core projects.
    </Description>
    <PackageProjectUrl>https://github.com/PabloMickaelQuevedo/PMQ.ErrorHandling</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PabloMickaelQuevedo/PMQ.ErrorHandling.git</RepositoryUrl>
    <PackageTags>error-handling;exception-handling;filters;validation;aspnetcore;notifications</PackageTags>
    <IncludeLicenseFile>true</IncludeLicenseFile>
  </PropertyGroup>
  <!--
    Compara a API deste build com a do pacote já publicado, baixado do NuGet, e por
    target framework. Remover membro público reprova o pack com CP0002.

    O baseline é a última versão publicada e sobe junto com o release. Quebra
    intencional se registra com -p:ApiCompatGenerateSuppressionFile=true, commitando
    o arquivo gerado — a decisão fica explícita e revisável em vez de silenciosa.

    Compara assinatura, não piso de dependência: subir o grupo net8.0 para um pacote
    10.x continua sendo trabalho do guard em Directory.Build.targets.
  -->
  <PropertyGroup Label="Compatibilidade">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.1.4</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      FrameworkReference no lugar de Microsoft.AspNetCore.Mvc.Core 2.3.9: aquele pacote é um
      shim da era ASP.NET Core 2.x e arrastava um grafo de dependências antigo para o app.
      A referência ao shared framework usa o MVC da própria versão do runtime hospedeiro.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="PMQ.Notifications" />
  </ItemGroup>

</Project>
